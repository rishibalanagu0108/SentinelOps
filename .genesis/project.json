  "project": {
    "name": "SentinelOps",
    "mode": "init",
    "profile": "prototype",
    "objective": "Build a local-first incident-response system that runs reproducible failures against a disposable application, investigates evidence, and performs only human-approved remediation while remaining ready for future external integrations.",
    "constraints": [
      "Local Docker Compose is the first supported runtime.",
      "Product code must not target real production infrastructure in the initial release."
    ],
    "non_goals": [
      "External SaaS, observability, incident-management, and cloud connectors in the initial release.",
      "Unattended production remediation."
    ],
    "trust_boundary": "local developer machine and disposable Docker environment",
