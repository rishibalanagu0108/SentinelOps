  "decisions": [
    {
      "id": "DECISION-2fc34efe",
      "title": "Local-first validation",
      "text": "Build and prove the complete incident workflow against a disposable Docker Compose application before adding external project connectors.",
      "status": "accepted",
      "source": "User discussion in this Codex chat on 2026-11-23",
      "recorded_at": "2026-11-23T17:28:27.144Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-9484f45a",
      "title": "Human-approved remediation",
      "text": "All state-changing remediation is allowlisted, scoped to the active incident, and blocked until a human explicitly approves it.",
      "status": "accepted",
      "source": "User discussion in this Codex chat on 2026-11-23",
      "recorded_at": "2026-11-23T17:28:27.271Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-aa3a1a57",
      "title": "Incremental incident catalog",
      "text": "Implement the faulty payments deployment first, then database connection exhaustion, then Redis unavailability; run scenarios sequentially and reset between them.",
      "status": "superseded",
      "source": "User discussion in this Codex chat on 2026-11-23",
      "recorded_at": "2026-11-23T17:28:27.389Z",
      "paths": [],
      "tags": [],
      "superseded_by": "DECISION-3340c0f2"
    },
    {
      "id": "DECISION-c40854e0",
      "title": "Connector-ready without plugin framework",
      "text": "Keep local telemetry, runtime, deployment, and remediation access behind simple module boundaries. Do not build dynamic plugins or external adapters until the local workflow is proven.",
      "status": "accepted",
      "source": "Genesis Ponytail full and user discussion in this Codex chat on 2026-11-23",
      "recorded_at": "2026-11-23T17:28:27.526Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-76f0e66e",
      "title": "Separate failure scenarios from incidents",
      "text": "Use SCN-* for deliberately injected local failure scenarios and reserve INC-* for incident records SentinelOps creates from accepted alerts.",
      "status": "accepted",
      "source": "User clarification in Codex chat on 2026-11-24",
      "recorded_at": "2026-11-24T06:15:01.287Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-68d3570f",
      "title": "Alert-driven local incident creation",
      "text": "For the local MVP, Prometheus evaluates versioned metric rules, Alertmanager posts firing and resolved notifications to the SentinelOps webhook, and SentinelOps validates and deduplicates alerts before creating or updating an incident.",
      "status": "accepted",
      "source": "User clarification in Codex chat on 2026-11-24",
      "recorded_at": "2026-11-24T06:15:01.445Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-3340c0f2",
      "title": "Incremental failure-scenario catalog",
      "text": "Implement SCN-001 faulty payments deployment first, then SCN-002 database connection exhaustion, then SCN-003 Redis unavailability; run scenarios sequentially and reset between them.",
      "status": "accepted",
      "source": "Revised SentinelOps terminology approved in Codex chat on 2026-11-24",
      "recorded_at": "2026-11-24T06:22:01.113Z",
      "paths": [],
      "tags": [],
      "supersedes": "DECISION-aa3a1a57"
    }
  ],
